# Production environment variables (used by Vercel build)
REACT_APP_NAME=RecruBotX
REACT_APP_ENV=production
REACT_APP_DEFAULT_LANGUAGE=en
REACT_APP_VERSION=1.0.0

# Use relative path so REST API requests go through Vercel's rewrite proxy
# (vercel.json rewrites /api/* -> https://interveuu.onrender.com/api/*)
REACT_APP_API_URL=/api

# Direct backend URL for WebSocket connections (Vercel rewrites don't support WebSocket)
REACT_APP_BACKEND_URL=https://interveuu.onrender.com
